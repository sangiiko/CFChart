{
  "manifest_version": 3,
  "name": "CFChart - Codeforces Daily Habit & Rating Horizon",
  "version": "1.0.0",
  "description": "Codeforces 2-problems-a-day habit tracker with in-page Codeforces overlay and grey-horizon rating predictor.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "CFChart"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://codeforces.com/*",
    "https://codeforces.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://codeforces.com/*", "https://codeforces.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dashboard.html", "icons/*", "content.css"],
      "matches": ["*://codeforces.com/*", "https://codeforces.com/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "cfchart@sangiko.extension",
      "strict_min_version": "109.0"
    }
  }
}
