{
  "manifest_version": 3,
  "name": "CFChart: Codeforces Charts & Practice",
  "version": "2.0.9",
  "description": "Enhanced in-page Codeforces rating charts, ML rating forecasts, daily practice streaks, and intelligent problem recommendations.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "CFChart"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "*://*.codeforces.com/*",
    "*://codeforces.com/*",
    "*://*.codeforces.net/*",
    "*://codeforces.net/*",
    "*://*.codeforces.org/*",
    "*://codeforces.org/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.codeforces.com/*",
        "*://codeforces.com/*",
        "*://*.codeforces.net/*",
        "*://codeforces.net/*",
        "*://*.codeforces.org/*",
        "*://codeforces.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "*://*.codeforces.com/*",
        "*://codeforces.com/*",
        "*://*.codeforces.net/*",
        "*://codeforces.net/*",
        "*://*.codeforces.org/*",
        "*://codeforces.org/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "cfchart@sangiko.extension",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "update_url": "https://github.com/sangiiko/CFChart/releases/latest/download/updates.json"
    }
  }
}
